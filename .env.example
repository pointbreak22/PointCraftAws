# Copy to .env on the VM and fill in real values. .env is git-ignored — never commit it.

# Origin the browser is served from (used for the API's CORS policy).
ALLOWED_ORIGIN=https://pointcraft.duckdns.org

# JWT auth — leave blank until an identity provider (e.g. AWS Cognito) is set up.
JWT_AUTHORITY=
JWT_AUDIENCE=

# Telegram notifications for new contact requests — see DEPLOY.md "Telegram notifications"
# for how to get a bot token and chat ID. Leave TELEGRAM_BOT_ENABLED=false until both are set.
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
