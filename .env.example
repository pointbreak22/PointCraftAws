# Copy to .env on the VM and fill in real values. .env is git-ignored — never commit it.

# Origin the browser is served from (used for the API's CORS policy).
ALLOWED_ORIGIN=https://pointcraft.duckdns.org

# JWT auth — leave blank until an identity provider (e.g. AWS Cognito) is set up.
JWT_AUTHORITY=
JWT_AUDIENCE=

# Telegram notifications for new contact requests — see DEPLOY.md "Telegram notifications"
# for how to get a bot token, and how recipients are added (TelegramSubscribers table, not
# an env var). Leave TELEGRAM_BOT_ENABLED=false until the token is set and at least one
# subscriber row exists.
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=

# Daily SQLite backups to S3 — see DEPLOY.md "Automated backups to S3". The IAM user behind
# these keys should only ever have PutObject/GetObject/ListBucket on this one bucket.
S3_BACKUP_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
