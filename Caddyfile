# No domain yet — plain HTTP on the VM's IP.
:80 {
	handle /api/* {
		reverse_proxy api:8080
	}

	handle /hubs/* {
		reverse_proxy api:8080
	}

	handle {
		reverse_proxy client:4000
	}
}

# Once a domain points at the VM, replace the ":80" block above with this one —
# Caddy will provision and renew the Let's Encrypt certificate automatically.
#
# yourdomain.com {
# 	handle /api/* {
# 		reverse_proxy api:8080
# 	}
#
