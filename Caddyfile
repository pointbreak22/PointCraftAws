pointbreakvexforge.com {
	handle /api/* {
		reverse_proxy api:8080
	}

	handle /hubs/* {
		reverse_proxy api:8080
	}

	handle {
		reverse_proxy client:4000
	}
}

# www permanently redirects (301) to the main domain, keeping the path and query.
www.pointbreakvexforge.com {
	redir https://pointbreakvexforge.com{uri} permanent
}
