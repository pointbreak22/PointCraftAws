pointbreakvexforge.com {
	handle /api/* {
		reverse_proxy api:8080
	}

	handle /hubs/* {
		reverse_proxy api:8080
	}

	handle {
		reverse_proxy client:4000
	}
}

# www and the old DuckDNS address permanently redirect (301) to the main domain, keeping the
# path and query, so search engines move their index and old links keep working.
www.pointbreakvexforge.com, pointcraft.duckdns.org {
	redir https://pointbreakvexforge.com{uri} permanent
}
